    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "archiver": "^7.0.1", "dotenv": "^16.6.1", "express": "^5.1.0", "lucide-react": "^0.468.0", "react": "^19.1.0", "react-dom": "^19.1.0", "sharp": "^0.35.3", "tsx": "^4.20.0" },
  "devDependencies": { "@types/archiver": "^6.0.3", "@types/express": "^5.0.3", "@types/node": "^22.15.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "@vitejs/plugin-react": "^4.7.0", "concurrently": "^9.2.0", "typescript": "^5.8.0", "vite": "^6.3.0" }
}
