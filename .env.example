# Node 22.13+; copy to .env (never commit real keys).
PORT=4317
HOST=127.0.0.1
# Required if HOST listens outside loopback. Set a long random secret.
STUDIO_TOKEN=
# Optional; defaults to ./data. Keep on a persistent volume.
DATA_DIR=./data
# For a public reverse proxy, list your own public hostname and full origin.
# STUDIO_ALLOWED_HOSTS=studio.example.com
# STUDIO_ALLOWED_ORIGINS=https://studio.example.com
# Configure image provider, Base URL, model and key in the app settings.
